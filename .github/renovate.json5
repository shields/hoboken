{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":semanticCommitsDisabled"],
  ignorePaths: [],
  abandonmentThreshold: "2 years",
  platformAutomerge: true,
  customManagers: [
    {
      customType: "regex",
      description: "Track the Mosquitto integration broker release and source commit",
      managerFilePatterns: ["/^Makefile$/"],
      matchStrings: [
        "TEST_BROKER_VERSION = (?<currentValue>v[0-9.]+)\\nTEST_BROKER_REVISION = (?<currentDigest>[a-f0-9]{40})",
      ],
      depNameTemplate: "eclipse-mosquitto/mosquitto",
      // GitHub tags resolves peeled commit digests, keeping both pins together.
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      description: "Automerge non-major updates",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      description: "Automerge dev dependencies",
      matchDepTypes: ["devDependencies"],
      automerge: true,
    },
    {
      description: "Automerge lockfile maintenance",
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
    },
    {
      description: "Group Playwright npm package and Docker image together",
      matchPackageNames: ["playwright", "mcr.microsoft.com/playwright"],
      groupName: "playwright",
      // config:best-practices holds the npm release for 3 days, and Renovate
      // leaves a held update out of the group's branch, so the image arrives
      // alone first. MCR reports no release times, so a matching hold on the
      // image would never expire. test/toolchain.test.ts keeps the partial
      // branch from merging until the npm release joins it.
    },
    {
      description: "Group packageManager's Bun with the Bun images in both Dockerfiles",
      matchPackageNames: ["bun", "oven/bun"],
      groupName: "bun",
      // config:best-practices holds npm releases for 3 days, and Renovate
      // leaves held updates out of a group's branch, so the images need the
      // same hold to avoid landing ahead of packageManager. Only Docker Hub
      // reports release times, so this hold on MCR or gcr.io images would
      // never expire.
      minimumReleaseAge: "3 days",
    },
  ],
}
